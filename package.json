{
  "name": "techlogia",
  "version": "0.5.1",
  "description": "Techlogia Lab — Lernplattform als CLI. Module browsen, Lektionen lesen, VM-Sessions starten, Klassen verwalten — direkt im Terminal.",
  "type": "commonjs",
  "bin": {
    "techlogia": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "techlogia",
    "cli",
    "lab",
    "lernplattform",
    "education",
    "devops"
  ],
  "author": "Techlogia <info@techlogia.de>",
  "license": "MIT",
  "homepage": "https://techlogia.de",
  "repository": {
    "type": "git",
    "url": "https://github.com/TechLogia-de/techlogia-cli"
  },
  "bugs": {
    "url": "https://github.com/TechLogia-de/techlogia-cli/issues",
    "email": "info@techlogia.de"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.15.1",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "conf": "^10.2.0",
    "marked": "^14.1.3",
    "marked-terminal": "^7.2.1",
    "ora": "^5.4.1",
    "prompts": "^2.4.2",
    "shell-quote": "^1.8.3",
    "ws": "^8.20.1"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/prompts": "^2.4.9",
    "@types/shell-quote": "^1.7.5",
    "@types/ws": "^8.18.1",
    "msw": "^2.4.9",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
